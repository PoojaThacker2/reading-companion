# Option A: OpenAI
OPENAI_API_KEY=

# Option B: Ollama (local, no API key). Setting OLLAMA_URL switches everything to Ollama.
# Pull first: ollama pull nomic-embed-text ; ollama pull llama3.2:3b
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=llama3.2:3b
# Minimum similarity for a chunk to count as relevant (0 = off). For nomic-embed-text,
# in-book scores ~0.60-0.77 and off-topic ~0.44-0.53, so 0.57 separates them.
# MIN_SCORE=0.57
